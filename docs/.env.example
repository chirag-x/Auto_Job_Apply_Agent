# Database
DB_PATH=agent_data.sqlite3

# --- Provider 1: Local Ollama (Primary - Zero Cost) ---
OLLAMA_MODEL_NAME=ollama/qwen2.5:7b
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_API_KEY=ollama_local

# --- Provider 2: Google Gemini (Free Tier Backup) ---
GEMINI_MODEL_NAME=gemini/gemini-1.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com
GEMINI_API_KEY=your_gemini_api_key_here

# --- Provider 3: OpenRouter (Backup) ---
OPENROUTER_MODEL_NAME=openrouter/meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Provider 4: OmniRoute (Free Gateway Backup) ---
OMNIROUTE_MODEL_NAME=openai/auto/best-free
OMNIROUTE_API_BASE=http://localhost:8000/v1
OMNIROUTE_API_KEY=your_omniroute_token_here

# Fallback Order (Comma-separated model names matching the above)
MODEL_PRIORITY_ORDER=ollama/qwen2.5:7b,gemini/gemini-1.5-flash,openrouter/meta-llama/llama-3.1-8b-instruct:free,openai/auto/best-free